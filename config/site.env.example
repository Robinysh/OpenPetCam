# OpenPetCam per-install settings. Copy to config/site.env (git-ignored) and fill in.
# Nothing here is a secret: passwords and keys are set on the server by set-secrets.sh
# and never leave it. Still, this file names your server, so it stays out of git.

# Your pet
PET_NAME=Biscuit
PET_PRONOUN=she              # she | he | they
# PET_KIND=dog               # dog | cat: which animal the verifier accepts (cats: detection and sight only for now, no cat sounds)
# One line describing your pet, used when Claude labels training crops (tools/bootstrap_pet.py).
PET_DESCRIPTION="Biscuit, a small dog with a cream coat"
# Things at home that look like your pet (helps the labeller say no to them).
PET_LOOKALIKES="a brown plush dog toy, tennis balls"
# APP_NAME="Biscuit cam"     # optional, defaults to "<PET_NAME> cam"

# Your server (any Ubuntu 24.04 VM with a public IP; a $5 Lightsail nano is enough)
PUBLIC_IP=203.0.113.10
PUBLIC_HOST=petcam.203-0-113-10.sslip.io   # any DNS name pointing at PUBLIC_IP; sslip.io needs no setup
TZ=America/New_York

# Updates from GitHub releases, checked daily (server/update.py). release = install them; off = only tell you.
# A server deployed from a checkout that is not exactly a release tag is never updated automatically.
UPDATE_CHANNEL=release
# UPDATE_REPO=crimeacs/OpenPetCam

# The agent (optional) offers fixes proven on this install upstream as pull requests (tools/contribute.py).
# Needs your fork as git 'origin' and `gh auth login`. off = keep fixes local.
CONTRIBUTE=pr
# UPSTREAM_REPO=crimeacs/OpenPetCam

# Which camera (optional; the default is the reference Thingino pan/tilt camera below). See docs/raspberry-pi.md.
#   CAMERA=rpi            a Raspberry Pi camera on the same machine as the server: no WireGuard, no cloud VM.
#   PTZ=0                 no motors: Find, Follow, joystick, tap-to-aim and places are refused and hidden.
#                         (the default is PTZ=1 for thingino, PTZ=0 for rpi)
#   AUDIO=0               no microphone: no sound detection, no talk-back (the default for rpi).
#   For rpi, also set SSH_HOST=local (deploy to this machine), PUBLIC_HOST=<this machine>.<tailnet>.ts.net and
#   PUBLIC_IP=<its Tailscale 100.x address>, and UPDATE_CHANNEL=off if you changed the code.
# CAMERA=thingino
# PTZ=1
# AUDIO=1
# RPI_CAM_WIDTH=1280          # the recorded stream (the watcher uses a 640x360 copy)
# RPI_CAM_HEIGHT=720
# RPI_CAM_FPS=20
# RPI_CAM_BITRATE=1500000     # software H.264 on a Pi 5; keep it modest
# RPI_CAM_MODE=1640:1232:10:P # sensor mode (width:height:bits:packing); empty = let libcamera choose
# RPI_CAM_HFLIP=no            # yes if the picture is mirrored
# RPI_CAM_VFLIP=no            # yes if the camera is mounted upside down
# FRAME_WIDTH=640             # the watcher's picture: 640 (default) up to 1280. Bigger sees smaller or more distant pets
# DETECT_WIDTH=416            # the detector's input width. 1024 with FRAME_WIDTH=1280 costs ~0.35 s per detector run on a Pi 5
# DETECTOR=yolox             # yolox (YOLOX-nano, Apache-2.0) or yolo26 (YOLO26-small, AGPL-3.0: check the licence). yolo26
                             # scores small, blurry pets higher and costs ~1.4 s per run at DETECT_WIDTH=1024 on a Pi 5 (one thread);
                             # deploy.sh exports its ONNX once into ~/.cache/petcam-build (1.5 GB of build tools).

# WireGuard tunnel between camera and server (defaults are fine; unused with CAMERA=rpi)
SERVER_WG_IP=10.77.0.1
CAMERA_WG_IP=10.77.0.2
# Camera on your home network, for tools/calibrate.py (optional)
CAMERA_LAN_IP=thingino.local
CAMERA_WG_PUBKEY=            # the camera's WireGuard public key, from Thingino's WireGuard page

# Laptop-only: how deploy.sh and the tools reach the server (not copied to the server)
# SSH_HOST=local means "this machine is the server" (no SSH; needs rsync and passwordless sudo).
SSH_HOST=ubuntu@203.0.113.10
SSH_KEY=~/.ssh/petcam.pem
# Optional, for tools/status.sh on AWS Lightsail: shows CPU burst credits
# LIGHTSAIL_INSTANCE=petcam
# LIGHTSAIL_REGION=us-east-1
