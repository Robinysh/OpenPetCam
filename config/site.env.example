# OpenPetCam per-install settings. Copy to config/site.env (git-ignored) and fill in.
# Nothing here is a secret: passwords and keys are set on the server by set-secrets.sh
# and never leave it. Still, this file names your server, so it stays out of git.

# Your pet
PET_NAME=Biscuit
PET_PRONOUN=she              # she | he | they
# One line describing your pet, used when Claude labels training crops (tools/bootstrap_pet.py).
PET_DESCRIPTION="Biscuit, a small dog with a cream coat"
# Things at home that look like your pet (helps the labeller say no to them).
PET_LOOKALIKES="a brown plush dog toy, tennis balls"
# APP_NAME="Biscuit cam"     # optional, defaults to "<PET_NAME> cam"

# Your server (any Ubuntu 24.04 VM with a public IP; a $5 Lightsail nano is enough)
PUBLIC_IP=203.0.113.10
PUBLIC_HOST=petcam.203-0-113-10.sslip.io   # any DNS name pointing at PUBLIC_IP; sslip.io needs no setup
TZ=America/New_York

# Updates from GitHub releases, checked daily (server/update.py). release = install them; off = only tell you.
# A server deployed from a checkout that is not exactly a release tag is never updated automatically.
UPDATE_CHANNEL=release
# UPDATE_REPO=crimeacs/OpenPetCam

# WireGuard tunnel between camera and server (defaults are fine)
SERVER_WG_IP=10.77.0.1
CAMERA_WG_IP=10.77.0.2
# Camera on your home network, for tools/calibrate.py (optional)
CAMERA_LAN_IP=thingino.local
CAMERA_WG_PUBKEY=            # the camera's WireGuard public key, from Thingino's WireGuard page

# Laptop-only: how deploy.sh and the tools reach the server (not copied to the server)
SSH_HOST=ubuntu@203.0.113.10
SSH_KEY=~/.ssh/petcam.pem
# Optional, for tools/status.sh on AWS Lightsail: shows CPU burst credits
# LIGHTSAIL_INSTANCE=petcam
# LIGHTSAIL_REGION=us-east-1
